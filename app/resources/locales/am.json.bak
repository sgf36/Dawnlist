  "onboarding.aim_label": "ምን እየፈለጉ ነው?",
  "onboarding.aim_placeholder": "በራስዎ አገላለጽ አንድ ወይም ሁለት ዓረፍተ ነገር ይጻፉ። ምን አይነት ሥራ፣ በግምት ምን ደረጃ፣ የት፣ ቋሚ ወይም በኮንትራት፣ እና ለውይይት የሚያበቃ ዝቅተኛ ደመወዝ ይግለጹ። የሚተዉት ማንኛውም ነገር ዳውንሊስት (Dawnlist) ገምቶ ማወቅ ይኖርበታል።",
  "onboarding.answer_placeholder": "የእርስዎ መልስ — መናገር ካልፈለጉ ክፍት ይተውት",
  "onboarding.answers_added": "{count} መልስ(ዎች) ከላይ ወዳለው የግል ማህደር ታሪክ ተጨምረዋል።",
  "onboarding.answers_none": "የሚጨመር አዲስ ነገር የለም — መጀመሪያ መልስ ይጻፉ።",
  "onboarding.app_no_verdict": "ግምገማው ለዚህ ማስታወቂያ ውጤት አላመጣም፣ ስለዚህ እስካሁን የሚስማሙበት ወይም የማይስማሙበት ነገር የለም",
  "onboarding.app_said": "Dawnlist {verdict} አለ — {reason}",
  "onboarding.app.judgement-call": "የግምገማ ውሳኔ",
  "onboarding.app.not-assessed": "ያልተገመገመ",
  "onboarding.app.possible": "ሊሆን የሚችል",
  "onboarding.app.rejected": "ተስማሚ አይደለም",
  "onboarding.app.strong": "በጣም ተስማሚ",
  "onboarding.back": "ተመለስ",
  "onboarding.blocker_decide": "ከ{total} ማስታወቂያዎች መካከል ቢያንስ {needed} ይወስኑ (እስካሁን {decided})",
  "onboarding.blocker_sentence": "{title} በ{company}፦ አልተስማሙም፣ ስለዚህ ወደ አጭሩ መግለጫ ቢጨመር ይህን ትክክል የሚያደርገው ዓረፍተ ነገር ይግለጹ — ያለ ዓረፍተ ነገር የሚደረግ ማስተካከያ አይቀጥልም",
  "onboarding.blocker_short_sample": "Dawnlist ለማመዛዘን በቂ ቀጥታ ማስታወቂያዎችን ማምጣት አልቻለም — ከሚያስፈልጉት {needed} ውስጥ {count} ብቻ አግኝቷል። ይህ እርስዎ ካደረጉት ነገር ይልቅ የማዋቀር ችግር ነው፦ ፍለጋ መንቃቱን እና ምንጩ ተደራሽ መሆኑን ያረጋግጡ፣ ከዚያ እንደገና ይሞክሩ።",
  "onboarding.brief_label": "የተስማሚነት ብሪፍ — የሚቀርበው",
  "onboarding.calibration_body": "እነሆ አስር ቀጥታ ማስታወቂያዎች፣ Dawnlist ስለ እያንዳንዳቸው ያሰበውን ጨምሮ። ስህተት የሆነውን ነገር ያስተካክሉ። ካልተስማሙ፣ የትኛው ዓረፍተ ነገር ትክክል ባደረገው ነበር ይንገሩት — ያ ዓረፍተ ነገር ወደ መግለጫዎ ይገባል፣ ስለዚህ ተመሳሳይ ስህተት በሚቀጥለው ሩጫ ላይ አይደገምም።",
  "onboarding.calibration_failed": "Dawnlist ለማመዛዘን ማስታወቂያዎችን ማምጣት አልቻለም፦ {reason} ማዋቀርን መጨረስ ይችላሉ፤ ማመዛዘኑ ምንጩን ማንበብ በሚችልበት ጠዋት ይከናወናል።",
  "onboarding.calibration_fetching": "ቀጥታ ማስታወቂያዎችን በማምጣት ላይ እና ከአጭሩ መግለጫዎ ጋር በማነጻጸር ላይ። ይህ አንድ ደቂቃ ያህል ይወስዳል።",
  "onboarding.calibration_heading": "ከመጀመሪያው ሩጫ በፊት",
  "onboarding.calibration_no_feed": "በዚህ ኮምፒውተር ላይ ምዝገባ ወይም መዳረሻ ኮድ ስለሌለ Dawnlist እስካሁን የሚያነብበት የስራ ምንጭ የለውም። ማዋቀርን መጨረስ ይችላሉ፤ ማዋቀሪያ ካገኙ በኋላ ማመዛዘኑ ይከናወናል።",
  "onboarding.calibration_pending": "Dawnlist እስካሁን አልተስተካከለም፣ ስለዚህ እነዚህ ውሳኔዎች በአጭሩ መግለጫዎ ላይ ብቻ የተመሰረቱ ናቸው እና ከእርስዎ ፍርድ ጋር በጭራሽ አልተነጻጸሩም። ማስተካከል ጥቂት ደቂቃዎችን ይወስዳል፦ Dawnlist አስር ቀጥታ ማስታወቂያዎችን ያሳይዎታል፣ የተሳሳተውን ያስተካክላሉ፣ እና አጭሩ መግለጫዎ ከልዩነቱ ይማራል።",
  "onboarding.calibration_review_btn": "ፍለጋዎችዎን ይገምግሙ",
  "onboarding.calibration_skipped": "ለመመዘኛ የሚበቁ በቂ ቀጥታ ማስታወቂያዎች አልነበሩም፣ ስለዚህ ይህ ደረጃ ታልፏል — የናንተ ጥፋት አይደለም። Dawnlist ፍለጋ ሲበራ እና መረጃ መስመሩ ተደራሽ ሲሆን በሚቀጥለው ጊዜ ሲከፍቱት ይህን ደረጃ እንደገና ያቀርባል። ማዋቀሩን መጨረስ ይችላሉ።",
  "onboarding.calibration_skipped_few": "ከፍለጋዎችዎ ላይ {count} ንቁ ማስታወቂያዎች ብቻ ተገኝተዋል፣ ነገር ግን ለመስተካከል {needed} ያስፈልጋሉ። ይህ ብዙ ጊዜ የፍለጋ ቃላትዎ በጣም የተለዩ መሆናቸውን ያመለክታል — አጠር ያሉ የርዕስ ቃላት (ለምሳሌ 'Head of Hotel Strategy' ከሚለው ይልቅ 'Hotel Strategy') ሰፋ ያለ ውጤት ያመጣሉ። ተመልሰው ፍለጋዎችዎን ማስተካከል እና እንደገና መሞከር ወይም አሁን ጨርሰው በኋላ መስተካከል ይችላሉ።",
  "onboarding.calibration_skipped_zero": "ከየትኛውም ፍለጋዎችዎ ምንም ንቁ ማስታወቂያዎች አልተገኙም። ይህ ብዙ ጊዜ የፍለጋ ቃላቱ ከምግቡ ጋር የሚዛመድ ነገር እንደሌላቸው ያመለክታል — ከሙሉ የስራ መጠሪያ ይልቅ አጠር ያሉ የርዕስ ቃላትን (ለምሳሌ 'Revenue Strategy') ይሞክሩ። ተመልሰው ፍለጋዎችዎን ማስተካከል እና እንደገና መሞከር ወይም አሁን ጨርሰው በኋላ መስተካከል ይችላሉ።",
  "onboarding.choose_files": "ፋይሎችን ይምረጡ…",
  "onboarding.choose_files_filter": "ሲቪዎች እና ሰነዶች",
  "onboarding.choose_files_title": "የሲቪ ፋይሎችዎን ይምረጡ",
  "onboarding.clarifications_heading": "## ያቀረቧቸው ማብራሪያዎች",
  "onboarding.close_anyway": "ቢሆንም ዝጋ",
  "onboarding.close_keep": "ማዋቀርን ይቀጥሉ",
  "onboarding.close_unsaved": "Dawnlist አሁንም አንድ ነገር በማከናወን ላይ ነው፣ ያልጨረሰውም ይጠፋል። ማዋቀርን ቢሆንም ይዘጋል?",
  "onboarding.corpus_earliest_year": "የተገኘው የመጀመሪያ ሚና የሚጀምረው በ{year} ነው። ከዚያ በፊት ሰርተው ከሆነ ይጨምሩት — ቀደምት የስራ ማስፈጸሚያ ሚናዎች ስክሪኑ በትክክል የሰሩትን ስራዎች የሚነግሩት ናቸው።",
  "onboarding.corpus_none": "ሊነበብ የሚችል የሲቪ ጽሑፍ አልተገኘም — ከመቀጠልዎ በፊት ፋይሎቹ በትክክል መከፈታቸውን ያረጋግጡ።",
  "onboarding.corpus_one_version": "አንድ የሲቪ ስሪት ብቻ ተነቧል። የተለያዩ ስሪቶች ተመሳሳዩን ሚና በተለያዩ ቃላት ይገልጻሉ፣ እነዚያ ልዩነቶች ማስረጃው ናቸው — ካሉዎት አሮጌዎቹን ይጨምሩ።",
  "onboarding.corpus_unreadable": "በቂ ጽሑፍ ከዚህ ማንበብ አልተቻለም፦ {files}",
  "onboarding.desc_hide": "Hide description",
