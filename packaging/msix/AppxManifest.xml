<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <!--
    CONFIRMED against Partner Center on 2026-09-08, read from
    Product management -> Product identity for Store ID 9PF25H395BB8.

    Name was "SFields.Dawnlist" and that was WRONG. The Store assigns the
    identity; it is not the reserved display name with the spaces removed, and
    it is not something to predict. The real value is SFields.DawnlistJobSearch.
    A mismatch fails INGESTION rather than certification, so it surfaces after
    upload and reads as an unrelated error.

    Do not "tidy" any of these three. The identity establishes the package
    family, and it is the key the Store uses to recognise an update: get it
    wrong after publishing and the app can only be replaced, never updated.

    Publisher is the account-wide publisher ID, the same value Easy-Post
    Desktop uses. It is not app-specific and does not change per product.

    For reference, both derived and NOT declared here:
      Package Family Name  SFields.DawnlistJobSearch_qhnp6qavahs3g
      Store listing URL    https://apps.microsoft.com/detail/9PF25H395BB8
  -->
  <Identity
    Name="SFields.DawnlistJobSearch"
    Publisher="CN=A7D4B6C0-27D4-4F66-82EB-82F5DD466788"
    Version="1.0.1.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <!-- MUST BE A NAME RESERVED IN PARTNER CENTER, character for character.
         Not a marketing decision: Partner Center refuses the package outright
         with "uses a display name that you have not reserved". This said
         "Dawnlist — Job Search" with an em dash on 2026-09-08 and was rejected
         at upload; the reserved name is "Dawnlist Job Search".

         The name customers SEE comes from the Store listing, where you pick
         from your reserved names — so this being the plain form costs nothing
         visually. To use the em-dash form publicly, reserve it first under
         Product management > Manage app names, then change this to match. -->
    <DisplayName>Dawnlist Job Search</DisplayName>
    <PublisherDisplayName>SFields</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <!--
    ONE language, deliberately. The package carries no MRT (.pri) language
    resources: the app localises itself at runtime from its own
    app/resources/locales/*.json, so at the package level every file is
    language-neutral and en-US is simply the default. Declaring the full
    50-language set here without a resources.pri to back it is what failed
    Store certification on the sibling app — the languages are a property of
    the running app, not of the package.
  -->
  <Resources>
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application Id="Dawnlist" Executable="Dawnlist.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Dawnlist Job Search"
        Description="Reads the world's job feeds every morning, judges every posting against your fit brief, and writes your follow-ups as drafts you send yourself."
        BackgroundColor="#1E4B45"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Square310x310Logo="Assets\LargeTile.png" Wide310x150Logo="Assets\Wide310x150Logo.png" Square71x71Logo="Assets\SmallTile.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <!--
      internetClient only. The app makes outbound HTTPS calls to the feed proxy
      and to Anthropic, and nothing else: no broadFileSystemAccess (files are
      opened through the user's own picker or dropped onto the window), no
      runFullTrust beyond the FullTrustApplication entry point that a packaged
      desktop app requires. Every capability declared here has to be justified
      at certification, and one you do not use is a rejection.
    -->
    <Capability Name="internetClient" />
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
