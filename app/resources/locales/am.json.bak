  "onboarding.seniority.senior_manager": "ከፍተኛ ማናጀር / መሪ / ዋና ኃላፊ",
  "onboarding.seniority.vp": "ምክትል ፕሬዝዳንት / ከፍተኛ ዳይሬክተር / ከፍተኛ አመራር",
  "onboarding.sentence_placeholder": "ወደ መመሪያዎ ቢጨመር ይህንን ትክክል የሚያደርገው ዓረፍተ ነገር ምንድን ነው?",
  "onboarding.submit_answers": "መልሶችን አስገባ",
  "onboarding.terms_accept": "ተስማምቼ እቀጥላለሁ",
  "onboarding.terms_agree": "ውሎቹን አንብቤያለሁ እና እስማማለሁ",
  "onboarding.terms_body": "Dawnlist ከመረጃ አቅራቢ የሚመጡ የስራ ማስታወቂያዎችን ያሳይዎታል፣ ውሎቹም በእነሱ ምን ማድረግ እንደሚችሉ ይሸፍናሉ። አጫጭር ናቸው። Dawnlist ያለ ስምምነት መጠቀም አይቻልም፣ ስለዚህ ከመቀጠልዎ በፊት እባክዎ ያንብቧቸው።",
  "onboarding.terms_changed": "ካለፈ ጊዜ ስምምነትዎ ወዲህ ውሎቹ ተቀይረዋል፣ ስለዚህ እባክዎ እንደገና ያንብቧቸው።",
  "onboarding.terms_heading": "ውሎቹ",
