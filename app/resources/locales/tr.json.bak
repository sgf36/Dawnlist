  "settings.clickup_placeholder": "pk_…",
  "settings.clickup_reconnect": "Reconnect",
  "settings.clickup_save": "Save",
  "settings.clickup_store_failed": "Dawnlist could not save the token because this computer's credential store did not respond.",
  "settings.clickup_stored": "Stored: {key}",
  "settings.clickup_token_saved": "Token saved.",
  "settings.code_redeemed": "Kod kabul edildi — lisansınız kaydedildi.",
  "settings.code_store_failed": "Kod kabul edildi, ancak bu bilgisayarın kimlik bilgisi deposu yanıt vermediği için Dawnlist size verilen lisansı kaydedemedi. Lisans anahtarınız {key} — kod ikinci kez çalışmayabileceğinden şimdi kopyalayıp saklayın.",
  "settings.data_body": "Dawnlist'teki iş ilanları, üçüncü taraf bir veri sağlayıcısından lisanslanmıştır. Bu ilanları kendi iş aramanız için kullanabilir, seçkinize eklediklerinizi saklayabilirsiniz. Bu ilanları çoğaltamaz, dağıtamaz, yeniden satamaz veya rakip bir iş bulma hizmeti oluşturmak için kullanamazsınız. Bu kısıtlamalar, aboneliğiniz sona erdikten sonra elinizde kalan ilanlar için de geçerliliğini sürdürür.",
  "settings.data_heading": "İş ilanlarının kaynağı",
  "settings.data_terms_link": "Sözleşmenin tamamını okuyun",
  "settings.email_address_placeholder": "you@example.com",
  "settings.email_body": "Connect your email account so Dawnlist can place drafts directly in your Drafts folder and learn your tone of voice from sent messages. Dawnlist never sends — you review and send each draft yourself.",
  "settings.email_heading": "Email account",
  "settings.email_host_placeholder": "imap.example.com",
  "settings.email_incomplete": "Enter your email address and IMAP server.",
