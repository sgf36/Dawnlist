  "draft.needs_evidence": "ማስረጃ ያስፈልጋል",
  "draft.never_sends": "Dawnlist በፍጹም አይልክም። እርስዎ ራስዎ ይልኩታል።",
  "draft.send_ready": "ከኢሜይል መተግበሪያዎ ለመላክ ዝግጁ ነው",
  "entitlement.keyring_unavailable": "Dawnlist የፍቃድ ቁልፍዎ የተቀመጠበትን የዚህ ኮምፒዩተር የመረጃ ማከማቻ (በዊንዶውስ ላይ Credential Manager፣ በማክ ላይ Keychain) መክፈት አልቻለም፣ እና ይህ ቅጂ በቅርቡ አልተረጋገጠም። የመረጃ ማከማቻውን ይክፈቱ ወይም እንደገና ያስጀምሩ እና እንደገና ይሞክሩ — ምንም ነገር አልተሰረዘም።",
  "entitlement.licence_inactive": "ይህ የፍቃድ ቁልፍ እውነተኛ ነው ነገር ግን ከአሁን በኋላ ንቁ አይደለም — ምዝገባው አልፎበታል፣ ተሰርዟል ወይም ተመላሽ ተደርጓል። ምዝገባውን ያድሱ እና ከዚያ እንደገና ያሂዱ፤ አሁንም ንቁ መሆን አለበት ብለው የሚያምኑ ከሆነ ወደ Apps@spencerfields.com ይጻፉ። ሰሌዳዎ እና ማጠቃለያዎ በሁለቱም ሁኔታ ክፍት ሆነው ይቆያሉ።",
  "entitlement.mac_lapsed": "App Store የእርስዎ Dawnlist ምዝገባ ንቁ እንዳልሆነ ገልጿል — አልፎበት፣ ተሰርዞ ወይም ተመላሽ ተደርጎ ሊሆን ይችላል። በ App Store ውስጥ ያድሱት፣ ከዚያ በቅንብሮች ውስጥ «ግዢ ማስመለስ»ን ይጫኑ። ሰሌዳዎ፣ ማጠቃለያዎ እና በዚህ ማክ ላይ ያለው ሁሉም ነገር ክፍት ሆነው ይቆያሉ።",
  "entitlement.mac_not_subscribed": "በዚህ ማክ ላይ እስካሁን የተረጋገጠ App Store ምዝገባ የለም፣ ስለዚህ የሚነበብ የሥራ ዝርዝር የለም። በቅንብሮች ውስጥ ይመዝገቡ፣ ወይም አስቀድመው ከተመዘገቡ እዚያ «ግዢ ማስመለስ»ን ይጫኑ። ሰሌዳዎ፣ ማጠቃለያዎ እና በዚህ ማክ ላይ ያለው ሁሉም ነገር ክፍት ሆነው ይቆያሉ።",
  "entitlement.mac_unreachable": "የእርስዎን App Store ምዝገባ ለማረጋገጥ ወደ ምዝገባ አገልግሎት መድረስ አልተቻለም፣ እና በቅርቡ አልተረጋገጠም። ግንኙነትዎን ያረጋግጡ እና እንደገና ይሞክሩ — ምንም ነገር አልተሰረዘም።",
  "entitlement.ms_lapsed": "የMicrosoft Store ምዝገባዎ አብቅቷል። ለመቀጠል በመተግበሪያው ውስጥ እንደገና ይመዝገቡ።",
  "entitlement.ms_not_subscribed": "ዳውንሊስት ምዝገባ ይፈልጋል። በመተግበሪያው ውስጥ ምዝገባ መጀመር ይችላሉ።",
  "entitlement.ms_unreachable": "Microsoft Store ላይ መድረስ አልተቻለም፣ ስለዚህ ምዝገባዎ ማረጋገጥ አልተቻለም። ዳውንሊስት እንደገና ይሞክራል።",
  "entitlement.no_variant": "ይህ የDawnlist ቅጂ ያለ ትክክለኛ የእትም ምልክት ({variant}) ተጭኗል፣ ስለዚህ ከየትኛው መደብር እንደመጣ መለየት አልቻለም እና ዕለታዊ ፍለጋውን አያካሂድም። ካገኙበት ቦታ እንደገና ይጫኑት። ሰሌዳዎ እና መግለጫዎ በሁለቱም ሁኔታ ክፍት ሆነው ይቆያሉ።",
  "export.done": "Exported {count} postings to CSV.",
  "export.title": "Export review",
  "families.adopt": "ይህን ደንብ አንቃ",
  "families.armed": "ንቁ",
  "families.armed_now": "{name} ንቁ ሆኗል። ተመሳሳይ ሚናዎች እዚያ ያለምንም ልፋት ይጣራሉ።",
  "families.body": "በአንድ ቀጣሪ ላይ ተመሳሳይ አይነት ሁለት የስራ መደቦችን ውድቅ ሲያደርጉ፣ Dawnlist አንድ ደንብ ያቀርባል፦ በዚያ ቀጣሪ ላይ ያለውን ተግባር አቁም፣ ነገር ግን ሌሎቹን ማንበብ ቀጥል። እርስዎ እስኪፈቅዱ ድረስ ምንም ነገር አይነቃም፣ እና እያንዳንዱ ሀሳብ የተመሰረተባቸውን ውድቅዎች ያሳያል።",
